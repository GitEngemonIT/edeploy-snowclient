						"body": {
							"mode": "raw",
							"raw": "{\n    \"input\": {\n        \"entities_id\": {{entity_id}},\n        \"status\": 1,\n        \"requesttypes_id\": {{snow_request_type_id}},\n        \"name\": \"{{snow_incident_id}} - Problema na impressora\",\n        \"content\": \"Incidente originado no ServiceNow.\\n\\n=== DETALHES DO SERVICENOW ===\\n- ServiceNow ID: {{snow_incident_id}}\\n- Tipo: Incident\\n- Estado Inicial: New (1)\\n- Prioridade: Medium\\n- Categoria: Hardware\\n- Subcategoria: Printer\\n\\n=== DESCRIÇÃO ===\\nUsuário reporta que a impressora do setor financeiro não está funcionando. Problema começou hoje pela manhã. Tentativas de reinicialização não resolveram.\\n\\n=== INFORMAÇÕES TÉCNICAS ===\\n- Local: Setor Financeiro\\n- Modelo: HP LaserJet Pro\\n- IP: 192.168.1.100\\n- Último funcionamento: Ontem às 18:00\\n\\nEste ticket foi criado automaticamente via integração ServiceNow → GLPI.\",\n        \"urgency\": 3,\n        \"impact\": 3,\n        \"priority\": 3,\n        \"type\": 1,\n        \"itilcategories_id\": 0,\n        \"_actors\": {\n            \"requester\": [\n                {\n                    \"itemtype\": \"User\",\n                    \"items_id\": {{glpi_requester_user_id}},\n                    \"use_notification\": 1\n                }\n            ]\n        }\n    }\n}"
